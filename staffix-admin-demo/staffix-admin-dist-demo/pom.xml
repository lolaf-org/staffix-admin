<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.lolaf</groupId>
        <artifactId>staffix-admin-demo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-admin-dist-demo</artifactId>
    <packaging>pom</packaging>
    <description>The console with the demo connector and users, the simulator, and a docker compose running both</description>

    <dependencies>
        <dependency>
            <groupId>org.lolaf</groupId>
            <artifactId>staffix-admin-dist</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>org.lolaf</groupId>
            <artifactId>staffix-admin-connector-demo</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf</groupId>
            <artifactId>staffix-admin-simulator</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>console</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>staffix-admin-demo</finalName>
                            <descriptors>
                                <descriptor>src/assembly/console.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docker</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>docker</finalName>
                            <attach>false</attach>
                            <descriptors>
                                <descriptor>src/assembly/docker.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

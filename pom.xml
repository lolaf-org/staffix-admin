<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <groupId>org.lolaf.staffix.admin</groupId>
    <artifactId>staffix-admin-parent</artifactId>
    <version>0.9.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Staffix Admin</name>
    <description>HTTP admin console for staffix FIX engines</description>
    <url>https://github.com/lolaf-org/staffix-admin</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>Lolaf.org</name>
        <url>https://www.lolaf.org</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>cmunger</id>
            <name>Cedric Munger</name>
            <url>https://github.com/cmunger</url>
            <organization>Lolaf.org</organization>
            <organizationUrl>https://www.lolaf.org</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/lolaf-org/staffix-admin.git</connection>
        <!-- HTTPS rather than ssh: the credential that pushes a release is a token. -->
        <developerConnection>scm:git:https://github.com/lolaf-org/staffix-admin.git</developerConnection>
        <url>https://github.com/lolaf-org/staffix-admin</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/lolaf-org/staffix-admin/issues</url>
    </issueManagement>

    <modules>
        <module>staffix-admin-audit</module>
        <module>staffix-admin-logs</module>
        <module>staffix-admin-metrics</module>
        <module>staffix-admin-store</module>
        <module>staffix-admin-connector-spi</module>
        <module>staffix-admin-server</module>
        <module>staffix-admin-ui</module>
        <module>staffix-admin-app</module>
        <module>staffix-admin-dist</module>
        <module>staffix-admin-demo</module>
        <module>staffix-admin-sandbox</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <node.version>v24.21.0</node.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <springdoc.version>3.1.1</springdoc.version>
        <json-schema-validator.version>3.0.8</json-schema-validator.version>
        <springdoc-openapi-maven-plugin.version>1.5</springdoc-openapi-maven-plugin.version>
        <staffix.version>0.9.1</staffix.version>
        <!-- Spring Boot's 4.35.1 is older than the gencode of staffix's opentelemetry-proto, which then fails to load -->
        <protobuf-java.version>4.36.2</protobuf-java.version>
        <license-maven-plugin.version>5.1.2</license-maven-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <!-- Appended to what maven-release-plugin passes to its forked builds -->
        <release.extraArguments />
        <lombok-maven-plugin.version>1.18.20.0</lombok-maven-plugin.version>
        <!-- Only the SPIs go to Central, and each turns these back on -->
        <delombok.skip>true</delombok.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-connector-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-metrics-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-logs-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-store-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-audit-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-metrics-prometheus</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-metrics-elasticsearch</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-logs-loki</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-logs-elasticsearch</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-logs-elasticsearch-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-metrics-clickhouse</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-logs-clickhouse</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-logs-clickhouse-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-connector-demo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-store-yaml</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-audit-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-api</artifactId>
                <version>${staffix.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-fix-44</artifactId>
                <version>${staffix.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lolaf.staffix.admin</groupId>
                <artifactId>staffix-admin-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok-maven-plugin</artifactId>
                    <version>${lombok-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <skip>${delombok.skip}</skip>
                        <addOutputDirectory>false</addOutputDirectory>
                        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                        <outputDirectory>${project.build.directory}/delombok</outputDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <doclint>all,-missing</doclint>
                        <failOnError>true</failOnError>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <detectOfflineLinks>false</detectOfflineLinks>
                        <quiet>true</quiet>
                        <sourcepath>${project.build.directory}/delombok</sourcepath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>release</releaseProfiles>
                        <useReleaseProfile>false</useReleaseProfile>
                        <arguments>-T1C ${release.extraArguments}</arguments>
                        <scmReleaseCommitComment>release @{releaseLabel}</scmReleaseCommitComment>
                        <scmDevelopmentCommitComment>resume development after @{releaseLabel}
                        </scmDevelopmentCommitComment>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>delombok-for-javadoc</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>delombok</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>source-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                    <message>Maven 3.6.3 or newer is required: older versions ignore the
                                        child.*.inherit.append.path attributes the published poms rely on.
                                    </message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Building staffix-admin needs JDK 21 or newer: it compiles for Java 21.
                                    </message>
                                </requireJavaVersion>
                                <requireReleaseDeps>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                    <message>A release may not depend on a SNAPSHOT: Central rejects the bundle, and the
                                        artifact would be unbuildable once that snapshot moved.
                                    </message>
                                </requireReleaseDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <aggregate>true</aggregate>
                    <licenseSets>
                        <licenseSet>
                            <header>${project.basedir}/HEADER.txt</header>
                            <excludes>
                                <exclude>**/LICENSE.txt</exclude>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.yaml</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.sh</exclude>
                                <exclude>**/mvnw</exclude>
                                <exclude>**/.mvn/**</exclude>
                                <exclude>**/pom.xml</exclude>
                                <exclude>**/src/main/resources/**</exclude>
                                <exclude>**/src/test/resources/**</exclude>
                                <exclude>**/src/config/**</exclude>
                                <exclude>staffix-admin-sandbox/console/**</exclude>
                                <exclude>staffix-admin-sandbox/docker/conf/**</exclude>
                                <exclude>**/*.html</exclude>
                                <exclude>**/.dockerignore</exclude>
                                <exclude>lombok.config</exclude>
                                <exclude>staffix-admin-ui/node/**</exclude>
                                <exclude>staffix-admin-ui/codegen/**</exclude>
                                <exclude>staffix-admin-ui/src/api/schema.d.ts</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <mapping>
                        <ts>SLASHSTAR_STYLE</ts>
                        <tsx>SLASHSTAR_STYLE</tsx>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- keyname comes from the CI secret -->
                            <bestPractices>true</bestPractices>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload and validate, then wait for a human: a published version can never
                                 be replaced or reused. -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- Only the SPIs and their parent POMs go to Central -->
                            <excludeArtifacts>
                                <excludeArtifact>staffix-admin-server</excludeArtifact>
                                <excludeArtifact>staffix-admin-ui</excludeArtifact>
                                <excludeArtifact>staffix-admin-app</excludeArtifact>
                                <excludeArtifact>staffix-admin-dist</excludeArtifact>
                                <excludeArtifact>staffix-admin-audit-log</excludeArtifact>
                                <excludeArtifact>staffix-admin-store-yaml</excludeArtifact>
                                <excludeArtifact>staffix-admin-metrics-prometheus</excludeArtifact>
                                <excludeArtifact>staffix-admin-metrics-elasticsearch</excludeArtifact>
                                <excludeArtifact>staffix-admin-metrics-clickhouse</excludeArtifact>
                                <excludeArtifact>staffix-admin-logs-loki</excludeArtifact>
                                <excludeArtifact>staffix-admin-logs-elasticsearch</excludeArtifact>
                                <excludeArtifact>staffix-admin-logs-elasticsearch-common</excludeArtifact>
                                <excludeArtifact>staffix-admin-logs-clickhouse</excludeArtifact>
                                <excludeArtifact>staffix-admin-logs-clickhouse-common</excludeArtifact>
                                <excludeArtifact>staffix-admin-demo</excludeArtifact>
                                <excludeArtifact>staffix-admin-connector-demo</excludeArtifact>
                                <excludeArtifact>staffix-admin-simulator</excludeArtifact>
                                <excludeArtifact>staffix-admin-dist-demo</excludeArtifact>
                                <excludeArtifact>staffix-admin-sandbox</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

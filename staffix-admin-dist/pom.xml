<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.lolaf.staffix.admin</groupId>
        <artifactId>staffix-admin-parent</artifactId>
        <version>0.9.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-admin-dist</artifactId>
    <packaging>pom</packaging>
    <name>Staffix Admin Distribution</name>
    <description>The console ready to run: its jar, the bundled plugins and an example configuration</description>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-metrics-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-metrics-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-logs-loki</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-logs-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-logs-elasticsearch-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-metrics-clickhouse</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-logs-clickhouse</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-logs-clickhouse-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-store-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix.admin</groupId>
            <artifactId>staffix-admin-audit-log</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>config-schemas</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath />
                                <argument>org.lolaf.staffix.admin.server.schema.ConfigSchemas</argument>
                                <argument>${project.build.directory}/config</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors>
                        <descriptor>src/assembly/distribution.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <!-- The unpacked directory keeps a fixed name for the Dockerfile and the docs; the archives are versioned -->
                    <execution>
                        <id>directory</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>staffix-admin</finalName>
                            <formats>
                                <format>dir</format>
                            </formats>
                        </configuration>
                    </execution>
                    <execution>
                        <id>archives</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>staffix-admin-${project.version}</finalName>
                            <formats>
                                <format>tar.gz</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

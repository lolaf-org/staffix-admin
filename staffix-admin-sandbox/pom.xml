<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.lolaf.staffix.admin</groupId>
        <artifactId>staffix-admin-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>staffix-admin-sandbox</artifactId>
    <description>Staffix engines trading with each other, announced to the console, exporting metrics and logs over OTLP</description>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-impl</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-admin-api-http-impl</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-monitoring-micrometer-otlp-impl</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-logger-otlp-impl</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-messages-store-memory-impl</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-sessions-settings-store-memory-impl</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-application-factory-simple</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.staffix</groupId>
            <artifactId>staffix-fixt-11</artifactId>
            <version>${staffix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.lolaf.staffix</groupId>
                <artifactId>staffix-fix-encoders-generator-maven-plugin</artifactId>
                <version>${staffix.version}</version>
                <configuration>
                    <sourcesOutputDirectory>${project.build.directory}/generated-sources/fix</sourcesOutputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>fix44</id>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>classpath:FIX44.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.admin.sandbox.fix44</packageName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fix50sp2</id>
                        <goals>
                            <goal>code-generator</goal>
                        </goals>
                        <configuration>
                            <dictionaryFile>classpath:FIX50SP2.xml</dictionaryFile>
                            <packageName>org.lolaf.staffix.admin.sandbox.fix50sp2</packageName>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.lolaf.staffix</groupId>
                        <artifactId>staffix-fix-44</artifactId>
                        <version>${staffix.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.lolaf.staffix</groupId>
                        <artifactId>staffix-fix-50sp2</artifactId>
                        <version>${staffix.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.lolaf.staffix.admin.sandbox.SandboxApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
